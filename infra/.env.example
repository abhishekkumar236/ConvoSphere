# Copy to infra/.env (git-ignored) and fill in. docker compose reads infra/.env automatically,
# because it sits next to docker-compose.infra.yml.
# Password: long and random, e.g. `openssl rand -hex 24`.

# RabbitMQ's one internal user: the management UI (http://127.0.0.1:15672) and every service
# (media-service, ...) log in with it. Apps never use it; they log in through the api.
# Applied on the FIRST start only (when the rabbitmq_data volume is empty). To change it
# later, change it in the management UI, then here.
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=
